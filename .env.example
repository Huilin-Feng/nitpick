# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Option A (local / CLI): fine-grained personal access token
GITHUB_TOKEN=

# Option B (webhook server): GitHub App
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=./private-key.pem
GITHUB_WEBHOOK_SECRET=

MAX_TOKENS_PER_CHUNK=6000
MAX_CHUNKS=5
MAX_COMMENTS=10
